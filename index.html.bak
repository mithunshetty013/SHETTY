<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Portfolio of Mithun Shetty - Software Engineer & System Architect specializing in modern full-stack web applications, system design, and clean code.">
  <title>Mithun Shetty | Software Engineer &amp; System Architect</title>
  
  <!-- Preconnect to Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&family=Inter:wght@300;400;500;600;700;800&family=Press+Start+2P&family=Silkscreen:wght@400;700&display=swap" rel="stylesheet">
  
  <!-- Stylesheet -->
  <link rel="stylesheet" href="style.css">
</head>
<body>

  <!-- ========================================================= -->
  <!-- HEADER & NAVIGATION                                      -->
  <!-- ========================================================= -->
  <header class="site-header" id="header">
    <div class="container header-container">
      <a href="#hero" class="brand-logo" aria-label="Home">
        <span class="logo-bracket">&lt;</span><span class="logo-text">Dev</span><span class="logo-accent">.Portfolio</span><span class="logo-bracket">/&gt;</span>
      </a>

      <!-- Desktop Navigation Menu -->
      <nav class="site-nav" id="site-nav" aria-label="Main Navigation">
        <ul class="nav-list">
          <li class="nav-item"><a href="#hero" class="nav-link active">Home</a></li>
          <li class="nav-item"><a href="#about" class="nav-link">About</a></li>
          <li class="nav-item"><a href="#skills" class="nav-link">Skills</a></li>
          <li class="nav-item"><a href="#timeline" class="nav-link">Timeline</a></li>
          <li class="nav-item"><a href="#projects" class="nav-link">Projects</a></li>
          <li class="nav-item"><a href="#contact" class="nav-link">Contact</a></li>
        </ul>
      </nav>

      <div class="header-actions">
        <!-- =================================================== -->
        <!-- PLACEHOLDER: NIGHT / DARK MODE TOGGLE               -->
        <!-- =================================================== -->
        <!-- 
          Night Mode Toggle Button:
          - Toggles light / dark color scheme
          - Accessible with aria-pressed and aria-label
          - Includes SVGs for Sun and Moon icons
        -->
        <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle dark/night mode" aria-pressed="true" title="Toggle night mode">
          <svg class="theme-icon icon-sun" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <svg class="theme-icon icon-moon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
          <span class="sr-only">Toggle Night Mode</span>
        </button>
        <!-- END PLACEHOLDER: NIGHT MODE TOGGLE -->

        <!-- Mobile Navigation Toggle -->
        <button id="mobile-menu-btn" class="mobile-menu-btn" aria-label="Open navigation menu" aria-expanded="false" aria-controls="site-nav">
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
        </button>
      </div>
    </div>
  </header>

  <!-- ========================================================= -->
  <!-- MAIN CONTENT AREA                                        -->
  <!-- ========================================================= -->
  <main id="main-content">

    <!-- ======================================================= -->
    <!-- ======================================================= -->
    <!-- SECTION: HERO (MODERN ART STYLE DESIGN)                 -->
    <!-- ======================================================= -->
    <section id="hero" class="section hero-section modern-art-hero" aria-labelledby="hero-heading">
      <!-- Ambient Modern Art Canvas Accents & Geometric Glow Elements -->
      <div class="modern-art-backdrop-glow" aria-hidden="true"></div>
      <div class="modern-art-geometric-nodes" aria-hidden="true">
        <span class="art-geo-node geo-node-1"></span>
        <span class="art-geo-node geo-node-2"></span>
        <span class="art-geo-node geo-node-3"></span>
      </div>

      <div class="container hero-container modern-art-container">
        <!-- Hero Content / Modern Art Editorial Canvas -->
        <div class="hero-content modern-art-canvas">
          
          <!-- Modern Art Live Status Badge -->
          <div class="modern-art-badge">
            <span class="art-indicator-ring">
              <span class="art-indicator-core"></span>
            </span>
            <span class="art-badge-label">SYSTEM ARCHITECT &bull; READY FOR NEW CHALLENGES</span>
          </div>

          <!-- Main Welcoming Title -->
          <h1 id="hero-heading" class="hero-title modern-art-title">
            <span class="hero-salutation">Welcome, I'm</span>
            <span class="hero-name-gradient">Mithun Shetty</span>
            <span class="hero-role-headline">Software Engineer &amp; System Architect</span>
          </h1>

          <!-- Brief Welcoming Tagline -->
          <p class="hero-description modern-art-tagline">
            Architecting high-concurrency distributed systems, robust cloud infrastructure, and immersive full-stack digital experiences where rigorous engineering meets the elegance of modern digital art.
          </p>

          <!-- Modern Art Key Metrics Strip -->
          <div class="modern-art-stats-strip" aria-label="Key engineering achievements">
            <div class="art-stat-box">
              <span class="art-stat-num">5<span class="art-stat-plus">+</span></span>
              <span class="art-stat-text">Years of Experience</span>
            </div>
            <div class="art-stat-divider" aria-hidden="true"></div>
            <div class="art-stat-box">
              <span class="art-stat-num">30<span class="art-stat-plus">+</span></span>
              <span class="art-stat-text">Production Projects</span>
            </div>
            <div class="art-stat-divider" aria-hidden="true"></div>
            <div class="art-stat-box">
              <span class="art-stat-num">99.9<span class="art-stat-plus">%</span></span>
              <span class="art-stat-text">System Uptime</span>
            </div>
          </div>

          <!-- Interactive Modern Art Action Buttons & Night Mode Toggle -->
          <div class="hero-actions modern-art-actions">
            <a href="#projects" class="art-btn art-btn-primary" id="hero-projects-btn">
              <span>View Projects</span>
              <svg class="art-btn-arrow" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
            
            <a href="#contact" class="art-btn art-btn-secondary" id="hero-contact-btn">
              <span>Get in Touch</span>
            </a>

            <!-- =================================================== -->
            <!-- HERO NIGHT MODE TOGGLE (MEDIA QUERY SYNCED)         -->
            <!-- =================================================== -->
            <button type="button" class="art-btn art-btn-toggle" id="hero-theme-toggle" aria-label="Toggle Night Mode" title="Toggle night / day mode">
              <span class="art-toggle-icon-wrap" aria-hidden="true">
                <!-- Sun Icon (Active in Dark Mode / Switches to Light) -->
                <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="5"></circle>
                  <line x1="12" y1="1" x2="12" y2="3"></line>
                  <line x1="12" y1="21" x2="12" y2="23"></line>
                  <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                  <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                  <line x1="1" y1="12" x2="3" y2="12"></line>
                  <line x1="21" y1="12" x2="23" y2="12"></line>
                  <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                  <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                </svg>
                <!-- Moon Icon (Active in Light Mode / Switches to Dark) -->
                <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                </svg>
              </span>
              <span class="art-toggle-label">
                <span class="art-toggle-caption">Theme:</span>
                <span class="art-toggle-status theme-text-status pixel-toggle-text">NIGHT MODE</span>
              </span>
            </button>
            <!-- END HERO NIGHT MODE TOGGLE -->
          </div>

          <!-- Modern Art Equipped Technology Matrix -->
          <div class="modern-art-tech-matrix">
            <span class="tech-matrix-title">CORE TECHNOLOGIES:</span>
            <div class="tech-tags modern-art-tags">
              <span class="art-tag"><span class="tag-accent-dot"></span> TypeScript</span>
              <span class="art-tag"><span class="tag-accent-dot"></span> React / Next.js</span>
              <span class="art-tag"><span class="tag-accent-dot"></span> Node.js</span>
              <span class="art-tag"><span class="tag-accent-dot"></span> Python / FastAPI</span>
              <span class="art-tag"><span class="tag-accent-dot"></span> PostgreSQL</span>
              <span class="art-tag"><span class="tag-accent-dot"></span> Docker / AWS</span>
            </div>
          </div>
        </div>

        <!-- Hero Visual: Modern Art Gallery Portrait & Asymmetric Framing -->
        <div class="hero-visual modern-art-visual">
          <div class="art-gallery-frame">
            <!-- Modern Art Geometric Floating Canvases -->
            <div class="art-geometric-backing art-backing-cyan" aria-hidden="true"></div>
            <div class="art-geometric-backing art-backing-violet" aria-hidden="true"></div>

            <!-- Main Portrait Card with Frosted Glass Border -->
            <div class="art-portrait-card">
              <div class="art-image-inner">
                <img src="mithun profilre.jpeg" alt="Mithun Shetty - Software Engineer" class="modern-art-image" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1534972195531-a756b1126f24?auto=format&fit=crop&w=600&q=80';">
                <div class="art-image-gradient-overlay"></div>
              </div>

              <!-- Modern Art Floating Chips -->
              <div class="art-floating-pill pill-top">
                <span class="pill-glow-orb"></span>
                <div class="pill-text-group">
                  <span class="pill-title">SYSTEM ARCHITECT</span>
                  <span class="pill-subtitle">Cloud &amp; Microservices</span>
                </div>
              </div>

              <div class="art-floating-pill pill-bottom">
                <span class="pill-icon">✦</span>
                <div class="pill-text-group">
                  <span class="pill-title">HIGH-IMPACT CODE</span>
                  <span class="pill-subtitle">Scalable Engineering</span>
                </div>
              </div>

              <!-- Card Status Bar -->
              <div class="art-card-footer">
                <span class="art-pulse-dot"></span>
                <span class="art-footer-status">ONLINE &bull; SAN FRANCISCO / BANGALORE</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- END SECTION: HERO -->

    <!-- ======================================================= -->
    <!-- SECTION: ABOUT (PLACEHOLDER)                            -->
    <!-- ======================================================= -->
    <!-- 
      About Section:
      - Biography / background story
      - Core philosophies & engineering focus
      - Key milestones or quick stats
    -->
    <section id="about" class="section about-section" aria-labelledby="about-heading">
      <div class="container">
        <div class="section-header">
          <span class="section-subtitle">Get To Know Me</span>
          <h2 id="about-heading" class="section-title">About Me</h2>
          <div class="section-divider"></div>
        </div>

        <div class="about-grid">
          <div class="about-bio">
            <p class="about-lead">
              I am a passionate software engineer with a strong foundation in computer science and full-stack development.
            </p>
            <p>
              Over the past 5+ years, I have worked across startups and enterprise environments designing scalable microservices, building responsive frontend applications, and automating cloud infrastructure.
            </p>
            <p>
              When I'm not writing code, you can find me contributing to open-source software, diving into developer tooling, writing technical articles, or mentoring junior developers.
            </p>
            
            <div class="about-highlights">
              <div class="highlight-item">
                <span class="highlight-icon">📍</span>
                <div>
                  <strong>Location</strong>
                  <p>San Francisco, CA (Open to Remote)</p>
                </div>
              </div>
              <div class="highlight-item">
                <span class="highlight-icon">🎓</span>
                <div>
                  <strong>Education</strong>
                  <p>B.S. in Computer Science</p>
                </div>
              </div>
              <div class="highlight-item">
                <span class="highlight-icon">💼</span>
                <div>
                  <strong>Focus</strong>
                  <p>Full-Stack &amp; Distributed Systems</p>
                </div>
              </div>
            </div>
          </div>

          <div class="about-stats-cards">
            <div class="stat-card">
              <span class="stat-number">5+</span>
              <span class="stat-label">Years of Experience</span>
            </div>
            <div class="stat-card">
              <span class="stat-number">30+</span>
              <span class="stat-label">Completed Projects</span>
            </div>
            <div class="stat-card">
              <span class="stat-number">15+</span>
              <span class="stat-label">Open Source PRs</span>
            </div>
            <div class="stat-card">
              <span class="stat-number">99.9%</span>
              <span class="stat-label">System Uptime Record</span>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- END SECTION: ABOUT -->

    <!-- ======================================================= -->
    <!-- SECTION: SKILLS (PLACEHOLDER)                           -->
    <!-- ======================================================= -->
    <!-- 
      Skills Section:
      - Categorized technical proficiencies:
        1. Languages (JS/TS, Python, Go, Java, SQL)
        2. Frontend (React, Vue, Next.js, HTML5/CSS3)
        3. Backend & Cloud (Node, Express, Django, AWS, Docker, K8s)
        4. Databases & Tools (PostgreSQL, Redis, Git, CI/CD)
    -->
    <section id="skills" class="section skills-section" aria-labelledby="skills-heading">
      <div class="container">
        <div class="section-header">
          <span class="section-subtitle">Technical Proficiency</span>
          <h2 id="skills-heading" class="section-title">Skills &amp; Technologies</h2>
          <div class="section-divider"></div>
        </div>

        <div class="skills-grid">
          <!-- Skill Category: Frontend -->
          <article class="skill-category-card">
            <div class="category-header">
              <span class="category-icon">🎨</span>
              <h3 class="category-title">Frontend Development</h3>
            </div>
            <ul class="skills-list">
              <li class="skill-pill">HTML5 &amp; Semantic Web</li>
              <li class="skill-pill">CSS3 / SASS / Flexbox / Grid</li>
              <li class="skill-pill">JavaScript (ES6+)</li>
              <li class="skill-pill">TypeScript</li>
              <li class="skill-pill">React &amp; Next.js</li>
              <li class="skill-pill">Tailwind &amp; CSS Modules</li>
              <li class="skill-pill">State Management (Redux/Zustand)</li>
            </ul>
          </article>

          <!-- Skill Category: Backend & APIs -->
          <article class="skill-category-card">
            <div class="category-header">
              <span class="category-icon">⚙️</span>
              <h3 class="category-title">Backend &amp; APIs</h3>
            </div>
            <ul class="skills-list">
              <li class="skill-pill">Node.js &amp; Express</li>
              <li class="skill-pill">Python &amp; FastAPI / Django</li>
              <li class="skill-pill">Go (Golang)</li>
              <li class="skill-pill">RESTful APIs &amp; GraphQL</li>
              <li class="skill-pill">Microservices Architecture</li>
              <li class="skill-pill">WebSockets &amp; Realtime Pub/Sub</li>
              <li class="skill-pill">Authentication (OAuth, JWT)</li>
            </ul>
          </article>

          <!-- Skill Category: Databases & Storage -->
          <article class="skill-category-card">
            <div class="category-header">
              <span class="category-icon">🗄️</span>
              <h3 class="category-title">Databases &amp; Caching</h3>
            </div>
            <ul class="skills-list">
              <li class="skill-pill">PostgreSQL</li>
              <li class="skill-pill">MySQL</li>
              <li class="skill-pill">MongoDB</li>
              <li class="skill-pill">Redis (Caching / Queues)</li>
              <li class="skill-pill">Prisma &amp; TypeORM</li>
              <li class="skill-pill">Database Indexing &amp; Query Tuning</li>
            </ul>
          </article>

          <!-- Skill Category: DevOps & Tools -->
          <article class="skill-category-card">
            <div class="category-header">
              <span class="category-icon">☁️</span>
              <h3 class="category-title">Cloud &amp; DevOps</h3>
            </div>
            <ul class="skills-list">
              <li class="skill-pill">AWS (S3, EC2, Lambda)</li>
              <li class="skill-pill">Docker &amp; Containers</li>
              <li class="skill-pill">Kubernetes Basics</li>
              <li class="skill-pill">CI/CD (GitHub Actions)</li>
              <li class="skill-pill">Git &amp; GitHub Version Control</li>
              <li class="skill-pill">Linux &amp; Shell Scripting</li>
            </ul>
          </article>
        </div>
      </div>
    </section>
    <!-- END SECTION: SKILLS -->

    <!-- ======================================================= -->
    <!-- SECTION: TIMELINE / EXPERIENCE (PLACEHOLDER)            -->
    <!-- ======================================================= -->
    <!-- 
      Timeline Section:
      - Chronological list of work experience and/or education
      - Company/Institution, Role/Degree, Dates, Key achievements
    -->
    <section id="timeline" class="section timeline-section" aria-labelledby="timeline-heading">
      <div class="container">
        <div class="section-header">
          <span class="section-subtitle">Career Journey</span>
          <h2 id="timeline-heading" class="section-title">Experience &amp; Timeline</h2>
          <div class="section-divider"></div>
        </div>

        <div class="timeline-wrapper">
          <!-- Timeline Item 1 -->
          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-content">
              <span class="timeline-date">2023 - Present</span>
              <h3 class="timeline-role">Senior Full-Stack Engineer</h3>
              <h4 class="timeline-company">TechNova Systems • San Francisco, CA</h4>
              <p class="timeline-desc">
                Architected high-throughput microservices handling over 5M daily requests. Led frontend modernization migration to React and TypeScript, reducing client load time by 42%.
              </p>
              <div class="timeline-tags">
                <span class="mini-tag">TypeScript</span>
                <span class="mini-tag">Next.js</span>
                <span class="mini-tag">Node.js</span>
                <span class="mini-tag">AWS</span>
              </div>
            </div>
          </div>

          <!-- Timeline Item 2 -->
          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-content">
              <span class="timeline-date">2021 - 2023</span>
              <h3 class="timeline-role">Software Engineer</h3>
              <h4 class="timeline-company">CloudPeak Innovations • New York, NY</h4>
              <p class="timeline-desc">
                Designed and maintained RESTful APIs in Python &amp; FastAPI. Implemented automated CI/CD pipelines with GitHub Actions and Docker, accelerating release cadence from bi-weekly to daily.
              </p>
              <div class="timeline-tags">
                <span class="mini-tag">Python</span>
                <span class="mini-tag">FastAPI</span>
                <span class="mini-tag">PostgreSQL</span>
                <span class="mini-tag">Docker</span>
              </div>
            </div>
          </div>

          <!-- Timeline Item 3 -->
          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-content">
              <span class="timeline-date">2019 - 2021</span>
              <h3 class="timeline-role">Junior Web Developer</h3>
              <h4 class="timeline-company">PixelCraft Digital • Austin, TX</h4>
              <p class="timeline-desc">
                Built responsive web interfaces with vanilla JavaScript, modern CSS, and REST API integrations. Collaborated closely with UX designers to translate Figma mockups into accessible code.
              </p>
              <div class="timeline-tags">
                <span class="mini-tag">JavaScript</span>
                <span class="mini-tag">CSS3</span>
                <span class="mini-tag">REST APIs</span>
                <span class="mini-tag">Git</span>
              </div>
            </div>
          </div>

          <!-- Timeline Item 4 (Education) -->
          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-content">
              <span class="timeline-date">2015 - 2019</span>
              <h3 class="timeline-role">B.S. in Computer Science</h3>
              <h4 class="timeline-company">State University of Technology</h4>
              <p class="timeline-desc">
                Graduated with Honors. Coursework included Data Structures &amp; Algorithms, Database Systems, Computer Networks, and Software Engineering Principles.
              </p>
              <div class="timeline-tags">
                <span class="mini-tag">Algorithms</span>
                <span class="mini-tag">Databases</span>
                <span class="mini-tag">OS &amp; Networks</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- END SECTION: TIMELINE -->

    <!-- ======================================================= -->
    <!-- SECTION: PROJECTS (PLACEHOLDER)                         -->
    <!-- ======================================================= -->
    <!-- 
      Projects Section:
      - Showcase of featured software engineering projects
      - Project card structure: Image/preview, Title, Description, Tech stack pills, Live demo & GitHub links
    -->
    <section id="projects" class="section projects-section" aria-labelledby="projects-heading">
      <div class="container">
        <div class="section-header">
          <span class="section-subtitle">Portfolio Showcase</span>
          <h2 id="projects-heading" class="section-title">Featured Projects</h2>
          <div class="section-divider"></div>
        </div>

        <div class="projects-grid">
          <!-- Project 1 -->
          <article class="project-card">
            <div class="project-image-box">
              <div class="project-preview-mockup">
                <span class="mockup-tag">Full-Stack SaaS</span>
                <h4 class="mockup-title">TaskFlow Pro</h4>
              </div>
            </div>
            <div class="project-body">
              <h3 class="project-title">TaskFlow - Collaborative Project Board</h3>
              <p class="project-description">
                A real-time Kanban and workflow management platform featuring WebSockets, role-based access control, and granular activity logging.
              </p>
              <div class="project-tags">
                <span class="tag">React</span>
                <span class="tag">TypeScript</span>
                <span class="tag">Node.js</span>
                <span class="tag">Socket.io</span>
                <span class="tag">PostgreSQL</span>
              </div>
              <div class="project-links">
                <a href="#projects" class="project-link" aria-label="View Live Demo for TaskFlow">
                  <span>Live Demo</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                </a>
                <a href="#projects" class="project-link" aria-label="View Source Code for TaskFlow">
                  <span>Source Code</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
                </a>
              </div>
            </div>
          </article>

          <!-- Project 2 -->
          <article class="project-card">
            <div class="project-image-box">
              <div class="project-preview-mockup">
                <span class="mockup-tag">Developer Tooling</span>
                <h4 class="mockup-title">LogPulse CLI</h4>
              </div>
            </div>
            <div class="project-body">
              <h3 class="project-title">LogPulse - Cloud Log Streamer &amp; Analyzer</h3>
              <p class="project-description">
                Lightweight CLI tool and monitoring service that streams distributed server logs, parses JSON payloads, and visualizes error frequency in real-time.
              </p>
              <div class="project-tags">
                <span class="tag">Go</span>
                <span class="tag">Docker</span>
                <span class="tag">Redis</span>
                <span class="tag">Prometheus</span>
              </div>
              <div class="project-links">
                <a href="#projects" class="project-link" aria-label="View Live Demo for LogPulse">
                  <span>Live Demo</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                </a>
                <a href="#projects" class="project-link" aria-label="View Source Code for LogPulse">
                  <span>Source Code</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
                </a>
              </div>
            </div>
          </article>

          <!-- Project 3 -->
          <article class="project-card">
            <div class="project-image-box">
              <div class="project-preview-mockup">
                <span class="mockup-tag">Fintech / Web3</span>
                <h4 class="mockup-title">VaultPay Engine</h4>
              </div>
            </div>
            <div class="project-body">
              <h3 class="project-title">VaultPay - Multi-Currency Payment Gateway</h3>
              <p class="project-description">
                High-security transaction processor equipped with cryptographic verification, idempotency controls, and webhook dispatching engine.
              </p>
              <div class="project-tags">
                <span class="tag">Python</span>
                <span class="tag">FastAPI</span>
                <span class="tag">PostgreSQL</span>
                <span class="tag">Stripe API</span>
              </div>
              <div class="project-links">
                <a href="#projects" class="project-link" aria-label="View Live Demo for VaultPay">
                  <span>Live Demo</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
