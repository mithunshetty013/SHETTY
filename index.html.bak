        </div>
      </div>
    </section>
    <!-- END SECTION: PROJECTS -->

    <!-- ======================================================= -->
    <!-- SECTION: CONTACT (PLACEHOLDER)                          -->
    <!-- ======================================================= -->
    <!-- 
      Contact Section:
      - Contact form with semantic inputs (Name, Email, Message)
      - Direct contact links (Email, LinkedIn, GitHub, X/Twitter)
    -->
    <section id="contact" class="section contact-section" aria-labelledby="contact-heading">
      <div class="container">
        <div class="section-header">
          <span class="section-subtitle">Let's Connect</span>
          <h2 id="contact-heading" class="section-title">Get In Touch</h2>
          <div class="section-divider"></div>
        </div>

        <div class="contact-grid">
          <div class="contact-info">
            <h3 class="contact-info-title">Have a project or opportunity in mind?</h3>
            <p class="contact-info-text">
              I am always eager to discuss software engineering challenges, exciting contract or full-time opportunities, and collaborative initiatives.
            </p>
            <div class="contact-methods">
              <a href="mailto:alex.dev@example.com" class="contact-item">
                <span class="contact-icon">✉️</span>
                <div>
                  <strong>Email</strong>
                  <p>alex.dev@example.com</p>
                </div>
              </a>
              <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="contact-item">
                <span class="contact-icon">💻</span>
                <div>
                  <strong>GitHub</strong>
                  <p>github.com/alexdev</p>
                </div>
              </a>
              <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="contact-item">
                <span class="contact-icon">🔗</span>
                <div>
                  <strong>LinkedIn</strong>
                  <p>linkedin.com/in/alexdev</p>
                </div>
              </a>
            </div>
          </div>

          <form class="contact-form" action="#" method="POST" id="contact-form">
            <div class="form-group">
              <label for="contact-name">Your Name</label>
              <input type="text" id="contact-name" name="name" placeholder="Jane Doe" required autocomplete="name">
            </div>
            <div class="form-group">
              <label for="contact-email">Email Address</label>
              <input type="email" id="contact-email" name="email" placeholder="jane@example.com" required autocomplete="email">
            </div>
            <div class="form-group">
              <label for="contact-subject">Subject</label>
              <input type="text" id="contact-subject" name="subject" placeholder="Project Inquiry / Job Opportunity" required>
            </div>
            <div class="form-group">
              <label for="contact-message">Message</label>
              <textarea id="contact-message" name="message" rows="5" placeholder="Tell me about your project or role..." required></textarea>
            </div>
            <button type="submit" class="btn btn-primary btn-block">Send Message</button>
          </form>
        </div>
      </div>
    </section>
    <!-- END SECTION: CONTACT -->

  </main>

